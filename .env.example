# Copy to .env in this directory. .env is gitignored. Do not commit the password.
# Environment variables already set in the shell override this file.
# cargo run -p argos-gpui loads this from the workspace root and the current directory.

ARGOS_ZENOH_ENDPOINT=tls/argos.34.135.204.210.sslip.io:7448
ARGOS_ZENOH_PREFIX=terra/phone
ARGOS_ZENOH_USER=terra
ARGOS_ZENOH_PASSWORD=replace-with-fleet-password

# Local Zorvane, no user or password. Comment out the four hosted lines above
# and uncomment these, including the empty user and password:
# ARGOS_ZENOH_ENDPOINT=tcp/127.0.0.1:7447
# ARGOS_ZENOH_PREFIX=terra/rover
# ARGOS_ZENOH_USER=
# ARGOS_ZENOH_PASSWORD=

# Teleop caps are defense in depth. Terra enforces the real limits.
# Defaults match the provisional turning policy: 0.5 rad/s, 0.5 rad/s² accel,
# 0.8 rad/s² decel, 0.5 m radius, spin off. Uncomment to override.
# ARGOS_DRIVE_LINEAR=0.2
# ARGOS_DRIVE_YAW_RATE=0.5
# ARGOS_DRIVE_YAW_ACCEL=0.5
# ARGOS_DRIVE_YAW_DECEL=0.8
# ARGOS_DRIVE_MIN_RADIUS=0.5
# ARGOS_DRIVE_ALLOW_SPIN=0
# ARGOS_DEGRADED_YAW_RATE=0.4
# ARGOS_DEGRADED_SETTLE=1.0

# FPV camera. Signaling uses the Zenoh endpoint above. Media is receive-only WebRTC.
# ARGOS_FPV_STUN defaults to stun:stun.l.google.com:19302. Use none on a local router.
# TURN is optional. Leave the credential out of git.
# ARGOS_FPV_STUN=stun:stun.l.google.com:19302
# ARGOS_FPV_TURN_URL=turn:example.com:3478
# ARGOS_FPV_TURN_USERNAME=
# ARGOS_FPV_TURN_CREDENTIAL=

# Photorealistic 3D Tiles. Uncomment and replace the placeholder. Never commit a real key.
# MAPS_DEMO=1 draws the offline fixture and does not need this.
# GOOGLE_MAPS_API_KEY=
