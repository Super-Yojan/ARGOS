# Copy to .env in this directory. .env is gitignored. Do not commit the password.
# Environment variables already set in the shell override this file.
# cargo run -p argos-gpui loads this from the workspace root and the current directory.

ARGOS_ZENOH_ENDPOINT=tls/argos.34.135.204.210.sslip.io:7448
ARGOS_ZENOH_PREFIX=terra/phone
ARGOS_ZENOH_USER=terra
ARGOS_ZENOH_PASSWORD=replace-with-fleet-password

