ARGOS_DOMAIN=argos.example.com
ARGOS_ORIGIN=https://argos.example.com
GITHUB_CLIENT_ID=replace-with-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-oauth-client-secret
# Stable numeric GitHub account IDs, comma separated. Operator overrides viewer.
ARGOS_OPERATORS=123456
ARGOS_VIEWERS=
# Start with the simulated fleet. Switch to zenoh only after staging checks.
ARGOS_FLEET=demo
ARGOS_ZENOH_ENDPOINT=tcp/100.64.0.10:7448
ARGOS_ZENOH_PREFIX=terra/rover
# Optional HTTPS MapLibre style URL from a tile provider licensed for your deployment.
ARGOS_TILE_STYLE=
RUST_LOG=argos_server=info,tower_http=info
