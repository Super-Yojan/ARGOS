[Unit]
Description=ARGOS browser fleet control
After=network-online.target argos-router.service
Wants=network-online.target argos-router.service
[Service]
User=argos
Group=argos
EnvironmentFile=/etc/argos/server.env
WorkingDirectory=/var/lib/argos
ExecStart=/opt/argos/bin/argos-server
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/argos
PrivateTmp=true
[Install]
WantedBy=multi-user.target
