# Copy to .env.fleet at the repository root. Do not commit the filled-in file.
# Create a separate GitHub OAuth app for this local dashboard:
# Homepage: https://localhost:8443
# Callback: https://localhost:8443/auth/callback
GITHUB_CLIENT_ID=replace-with-local-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-local-oauth-client-secret
# Your numeric GitHub user ID (not username); comma-separated for multiple users.
ARGOS_OPERATORS=replace-with-your-numeric-github-id
ARGOS_VIEWERS=

# Existing hosted Terra router documented in packaging/gcp/README.md.
# Use the SAME endpoint, prefix and membership credentials as your Terra phones.
ARGOS_ZENOH_ENDPOINT=tls/argos.34.135.204.210.sslip.io:7448
ARGOS_ZENOH_PREFIX=terra/phone
ARGOS_ZENOH_USER=terra
ARGOS_ZENOH_PASSWORD=replace-with-fleet-membership-password

# Alternatives:
# LAN router: tcp/192.168.1.10:7448
# Router on this computer: tcp/host.docker.internal:7448
# Zorvane on this computer: tcp/host.docker.internal:7447, prefix terra/rover
# For a router without authentication, DELETE both user and password lines above.
ARGOS_TILE_STYLE=
RUST_LOG=argos_server=info,tower_http=info
